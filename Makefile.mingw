# Shared compiler selection for both COM components.
TOOLCHAIN ?= mingw
MINGW ?= i586-pc-mingw32
IDL ?= widl
IDLFLAGS ?= -I /usr/include/wine/windows
# Fedora installs MinGW type libraries alongside its headers.
TYPELIB_DIR ?= $(firstword $(wildcard /usr/$(MINGW)/sys-root/mingw/include/stdole2.tlb))
ifneq ($(TYPELIB_DIR),)
IDLFLAGS += -L $(dir $(TYPELIB_DIR))
endif
CFLAGS ?= -O2 -Wall
CXXFLAGS ?= -O2 -Wall

# Both drivers produce Windows PE DLLs. winegcc uses Clang and Wine import libraries.
DLLSUFFIX = .dll
ifeq ($(TOOLCHAIN),mingw)
BITS ?= $(if $(findstring x86_64,$(MINGW)),64,32)
DLLFLAGS = -Wl,--add-stdcall-alias
CC = $(MINGW)-gcc
CXX = $(MINGW)-g++
else ifeq ($(TOOLCHAIN),winegcc)
BITS ?= 64
WINE_TARGET ?= $(if $(filter 64,$(BITS)),x86_64,i686)-windows
CC = winegcc -b $(WINE_TARGET)
CXX = wineg++ -b $(WINE_TARGET)
else
$(error Unknown TOOLCHAIN '$(TOOLCHAIN)'; use mingw or winegcc)
endif

BUILD_DIR = build/$(TOOLCHAIN)-$(BITS)
CPPFLAGS += -I$(BUILD_DIR) -I.
ARCHFLAGS = -m$(BITS)
